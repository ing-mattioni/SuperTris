<?xml version="1.0" encoding="utf-8"?>
<!-- Marchio SuperTris: card scura con bordo lime, griglia 2x2,
     O ambra in alto a sinistra e X ciano in basso a destra.
     Vettoriale puro: scala correttamente a qualsiasi dimensione
     (menu, splash, launcher), a differenza del vecchio layer-list
     con inset fissi in dp che si deformava. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="128dp"
    android:height="128dp"
    android:viewportWidth="128"
    android:viewportHeight="128">

    <!-- Card scura arrotondata -->
    <path
        android:fillColor="@color/brand_midnight"
        android:pathData="M28,0 H100 A28,28 0 0 1 128,28 V100 A28,28 0 0 1 100,128 H28 A28,28 0 0 1 0,100 V28 A28,28 0 0 1 28,0 Z" />

    <!-- Bordo lime -->
    <path
        android:strokeColor="@color/brand_lime"
        android:strokeWidth="3.5"
        android:fillColor="#00000000"
        android:pathData="M29,5 H99 A24,24 0 0 1 123,29 V99 A24,24 0 0 1 99,123 H29 A24,24 0 0 1 5,99 V29 A24,24 0 0 1 29,5 Z" />

    <!-- Croce della griglia 2x2, con spiraglio al centro -->
    <path
        android:strokeColor="@color/brand_grid"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M64,22 L64,58 M64,70 L64,106 M22,64 L58,64 M70,64 L106,64" />

    <!-- O ambra nel quadrante in alto a sinistra -->
    <path
        android:strokeColor="@color/brand_amber"
        android:strokeWidth="6.5"
        android:fillColor="#00000000"
        android:pathData="M26,40 a14,14 0 1 0 28,0 a14,14 0 1 0 -28,0" />

    <!-- X ciano nel quadrante in basso a destra -->
    <path
        android:strokeColor="@color/brand_cyan"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:pathData="M75,75 L101,101 M101,75 L75,101" />
</vector>
